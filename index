        function calcSpkValues(item) {
            let totalQty = (parseInt(item.sizes?.S)||0) + (parseInt(item.sizes?.M)||0) + (parseInt(item.sizes?.L)||0) + (parseInt(item.sizes?.XL)||0) + (parseInt(item.sizes?.XXL)||0) + (parseInt(item.sizes?.XXXL)||0) + (parseInt(item.sizes?.custom)||0);
            
            let fm = appData.masterFabrics.find(f => f.name === item.fabricMaterial) || appData.masterFabrics[0];
            let gm = appData.masterGarments.find(g => g.name === item.garmentType) || appData.masterGarments[0];
            
            let totalMeters = 0;
            if (item.sizes && fm && fm.cons) {
                totalMeters += (parseInt(item.sizes.S)||0) * (fm.cons.S || 1.3);
                totalMeters += (parseInt(item.sizes.M)||0) * (fm.cons.M || 1.4);
                totalMeters += (parseInt(item.sizes.L)||0) * (fm.cons.L || 1.5);
                totalMeters += (parseInt(item.sizes.XL)||0) * (fm.cons.XL || 1.6);
                totalMeters += (parseInt(item.sizes.XXL)||0) * (fm.cons.XXL || 1.7);
                totalMeters += (parseInt(item.sizes.XXXL)||0) * (fm.cons.XXXL || 1.8);
                totalMeters += (parseInt(item.sizes.custom)||0) * (fm.cons.custom || 2.0);
            }
            let fabricKg = fm && fm.ratio ? totalMeters / fm.ratio : totalQty * 0.4;
            let materialCost = fabricKg * (fm?.pricePerKg || 85000);

            let sewCost = totalQty * (gm?.sewRate || 10000);
            let cutCost = totalQty * (gm?.cutRate || 2500);
            let qcCost = totalQty * (gm?.qcRate || 1500);
            
            let printObj = appData.masterPrint.find(p => p.code === item.printMethod);
            let printRate = printObj ? printObj.price : 5000;
            let printCost = printObj?.unit === 'meter' ? (totalMeters * printRate) : (totalQty * printRate);

            let cogsPcs = totalQty > 0 ? Math.round((materialCost + sewCost + cutCost + printCost + qcCost) / totalQty) : 0;
            
            let commission = 0;
            if (item.useCommission === 'yes') {
                let setsOf12 = Math.floor(totalQty / 12);
                let remainder = totalQty % 12;
                commission = (setsOf12 * 100000) + (remainder * 8000);
            }
            
            let incentiveRate = parseFloat(item.incentivePerPcs) || 0;
            let incentive = totalQty * incentiveRate;
            let totalSalary = commission + incentive;

            let tagihan = totalQty * (parseFloat(item.pricePerPcs) || gm?.basePrice || 75000);
            let opex = parseFloat(item.opex) || 100000;
            let totalCogsOverall = Math.round(materialCost + sewCost + cutCost + printCost + qcCost + totalSalary + opex);
            let netProfit = Math.round(tagihan - totalCogsOverall);

            return {
                totalQty,
                fabricKg: parseFloat(fabricKg.toFixed(2)),
                materialCost: Math.round(materialCost),
                printCost: Math.round(printCost),
                cogsPcs,
                commission: Math.round(commission),
                incentive: Math.round(incentive),
                totalSalary: Math.round(totalSalary),
                tagihan: Math.round(tagihan),
                totalCogsOverall,
                netProfit
            };
        }

