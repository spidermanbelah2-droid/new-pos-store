<!DOCTYPE html>
<html lang="id" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Savelle Store - Konveksi Management System</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#fdf4f5',
                            100: '#fbe8eb',
                            500: '#e11d48',
                            600: '#be123c',
                            700: '#9f1239',
                        }
                    }
                }
            }
        }
    </script>
    <!-- Font Inter & Lucide Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Chart.js for Sales & Financial Diagrams -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body { font-family: 'Inter', sans-serif; }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }
        .dark ::-webkit-scrollbar-thumb { background: #475569; }
    </style>
</head>
<body class="bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-100 min-h-screen flex flex-col transition-colors duration-200">

    <!-- Low Stock Banner -->
    <div id="lowStockBanner" class="hidden bg-amber-500 text-slate-950 px-4 py-2 text-sm font-medium flex items-center justify-between shadow-md z-50">
        <div class="flex items-center gap-2 max-w-7xl mx-auto w-full">
            <i data-lucide="alert-triangle" class="w-5 h-5 flex-shrink-0 animate-bounce"></i>
            <span id="lowStockText">Peringatan: Stock kain atau bahan menipis / minus!</span>
            <button onclick="switchTab('inventory')" class="ml-auto underline font-bold hover:text-white">Cek Inventory</button>
        </div>
    </div>

    <!-- Custom Modal -->
    <div id="customModal" class="fixed inset-0 bg-black/60 z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white dark:bg-slate-900 rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200 dark:border-slate-800">
            <div class="w-12 h-12 rounded-full bg-rose-100 dark:bg-rose-900/30 text-rose-600 dark:text-rose-400 flex items-center justify-center mb-4 mx-auto">
                <i data-lucide="info" class="w-6 h-6"></i>
            </div>
            <h3 id="modalTitle" class="text-lg font-bold text-center text-slate-900 dark:text-white mb-2">Konfirmasi</h3>
            <p id="modalMessage" class="text-sm text-center text-slate-600 dark:text-slate-400 mb-6">Pesan di sini.</p>
            <div id="modalActions" class="flex gap-3 justify-center">
                <button onclick="closeModal()" class="px-4 py-2 rounded-xl text-sm font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">Batal</button>
                <button id="modalBtnConfirm" class="px-4 py-2 rounded-xl text-sm font-medium bg-rose-600 text-white hover:bg-rose-700">Ya, Lanjutkan</button>
            </div>
        </div>
    </div>

    <!-- Main Layout -->
    <div class="flex h-screen overflow-hidden">
        
        <!-- Sidebar -->
        <aside class="w-64 bg-white dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800 flex flex-col z-30 transition-all duration-300 -translate-x-full md:translate-x-0 fixed md:relative h-full" id="sidebar">
            <div class="p-6 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-rose-600 to-pink-500 flex items-center justify-center text-white font-bold shadow-lg shadow-rose-500/30">S</div>
                    <div>
                        <h1 class="font-bold text-slate-900 dark:text-white tracking-wide">SAVELLE</h1>
                        <p class="text-xs text-slate-500 dark:text-slate-400 font-medium">Confectionery System</p>
                    </div>
                </div>
                <button onclick="toggleMobileSidebar()" class="md:hidden text-slate-500"><i data-lucide="x" class="w-5 h-5"></i></button>
            </div>

            <nav class="flex-1 overflow-y-auto p-4 space-y-1">
                <button onclick="switchTab('dashboard')" class="nav-btn w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800/60" data-target="dashboard">
                    <i data-lucide="layout-dashboard" class="w-5 h-5"></i> Dashboard
                </button>
                <button onclick="switchTab('spk')" class="nav-btn w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800/60" data-target="spk">
                    <i data-lucide="file-text" class="w-5 h-5"></i> Daftar Order & SPK
                </button>
                <button onclick="switchTab('master_fabric')" class="nav-btn w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800/60" data-target="master_fabric">
                    <i data-lucide="layers" class="w-5 h-5"></i> Master Pakaian & Kain
                </button>
                <button onclick="switchTab('master_print')" class="nav-btn w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800/60" data-target="master_print">
                    <i data-lucide="printer" class="w-5 h-5"></i> Master Cetak & Harga
                </button>
                <button onclick="switchTab('inventory')" class="nav-btn w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800/60" data-target="inventory">
                    <i data-lucide="package" class="w-5 h-5"></i> Inventory Stock
                </button>
                <button onclick="switchTab('finance')" class="nav-btn w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800/60" data-target="finance">
                    <i data-lucide="wallet" class="w-5 h-5"></i> Kas & Keuangan (Audit)
                </button>
                <button onclick="switchTab('revenue')" class="nav-btn w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800/60" data-target="revenue">
                    <i data-lucide="trending-up" class="w-5 h-5"></i> Revenue & Per-SPK
                </button>
                <button onclick="switchTab('salaries')" class="nav-btn w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800/60" data-target="salaries">
                    <i data-lucide="users" class="w-5 h-5"></i> Gaji Karyawan
                </button>
            </nav>

            <div class="p-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs text-slate-500">
                <span class="flex items-center gap-1.5"><span id="syncIndicator" class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span><span id="syncText">Sync Active</span></span>
                <div class="flex items-center gap-2">
                    <button onclick="resetAllData()" class="p-2 rounded-lg bg-rose-100 dark:bg-rose-900/30 text-rose-600 dark:text-rose-400 hover:bg-rose-200" title="Reset Semua Data ke 0"><i data-lucide="rotate-ccw" class="w-4 h-4"></i></button>
                    <button onclick="toggleDarkMode()" class="p-2 rounded-lg bg-slate-100 dark:bg-slate-800"><i data-lucide="sun" class="w-4 h-4 hidden dark:block"></i><i data-lucide="moon" class="w-4 h-4 block dark:hidden"></i></button>
                </div>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 flex flex-col h-screen overflow-hidden w-full">
            <header class="h-16 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 px-4 md:px-6 flex items-center justify-between z-20 flex-shrink-0">
                <div class="flex items-center gap-3">
                    <button onclick="toggleMobileSidebar()" class="md:hidden text-slate-700 dark:text-slate-200"><i data-lucide="menu" class="w-6 h-6"></i></button>
                    <h2 id="pageTitle" class="text-base md:text-lg font-bold text-slate-900 dark:text-white truncate">Dashboard Overview</h2>
                </div>
                <div class="text-right hidden sm:block">
                    <p id="currentDateTime" class="text-xs font-semibold text-slate-700 dark:text-slate-300"></p>
                    <p class="text-[10px] text-slate-400">Savelle Konveksi System (Admin WA: 085212627456)</p>
                </div>
            </header>

            <div class="flex-1 overflow-y-auto p-4 md:p-8 bg-slate-50 dark:bg-slate-950">
                
                <!-- TAB 1: DASHBOARD -->
                <section id="tab-dashboard" class="tab-content space-y-6">
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
                        <h3 class="font-bold text-sm text-slate-900 dark:text-white flex items-center gap-2">
                            <i data-lucide="calendar" class="w-4 h-4 text-rose-600"></i> Filter Periode Dashboard
                        </h3>
                        <div class="flex items-center gap-2 flex-wrap text-xs w-full sm:w-auto">
                            <select id="dashFilterMonth" onchange="renderDashboard()" class="px-3 py-2 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex-1 sm:flex-none">
                                <option value="">Semua Bulan</option>
                                <option value="01">Januari</option>
                                <option value="02">Februari</option>
                                <option value="03" selected>Maret</option>
                                <option value="04">April</option>
                                <option value="05">Mei</option>
                                <option value="06">Juni</option>
                                <option value="07">Juli</option>
                                <option value="08">Agustus</option>
                                <option value="09">September</option>
                                <option value="10">Oktober</option>
                                <option value="11">November</option>
                                <option value="12">Desember</option>
                            </select>
                            <select id="dashFilterYear" onchange="renderDashboard()" class="px-3 py-2 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex-1 sm:flex-none">
                                <option value="2026" selected>2026</option>
                                <option value="2025">2025</option>
                                <option value="2027">2027</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-3 md:gap-4">
                        <div class="bg-white dark:bg-slate-900 p-4 md:p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
                            <span class="text-[10px] md:text-[11px] font-semibold uppercase text-slate-400">Orderan Aktif</span>
                            <h3 id="dashActiveSPK" class="text-xl md:text-2xl font-bold text-slate-900 dark:text-white mt-1">0</h3>
                        </div>
                        <div class="bg-white dark:bg-slate-900 p-4 md:p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
                            <span class="text-[10px] md:text-[11px] font-semibold uppercase text-slate-400">Omset Periode Ini</span>
                            <h3 id="dashMonthlyOmset" class="text-base md:text-xl font-bold text-emerald-600 mt-1">Rp 0</h3>
                        </div>
                        <div class="bg-white dark:bg-slate-900 p-4 md:p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
                            <span class="text-[10px] md:text-[11px] font-semibold uppercase text-slate-400">Tagihan Gaji</span>
                            <h3 id="dashPendingSalaries" class="text-base md:text-xl font-bold text-rose-600 mt-1">Rp 0</h3>
                        </div>
                        <div class="bg-white dark:bg-slate-900 p-4 md:p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
                            <span class="text-[10px] md:text-[11px] font-semibold uppercase text-slate-400">Net Margin Periode</span>
                            <h3 id="dashNetMargin" class="text-base md:text-xl font-bold text-indigo-600 mt-1">Rp 0</h3>
                        </div>
                        <div class="bg-white dark:bg-slate-900 p-4 md:p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
                            <span class="text-[10px] md:text-[11px] font-semibold uppercase text-slate-400">Saldo Mandiri</span>
                            <h3 id="dashMandiriBalance" class="text-base md:text-xl font-bold text-blue-600 mt-1">Rp 0</h3>
                        </div>
                        <div class="bg-white dark:bg-slate-900 p-4 md:p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
                            <span class="text-[10px] md:text-[11px] font-semibold uppercase text-slate-400">Saldo GoPay</span>
                            <h3 id="dashGopayBalance" class="text-base md:text-xl font-bold text-emerald-500 mt-1">Rp 0</h3>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                        <div class="lg:col-span-2 bg-white dark:bg-slate-900 p-4 md:p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
                            <h3 class="font-bold text-sm md:text-base text-slate-900 dark:text-white mb-4 flex items-center gap-2">
                                <i data-lucide="bar-chart-3" class="w-5 h-5 text-rose-600"></i> Diagram Penjualan & Revenue
                            </h3>
                            <div class="h-64 md:h-72 relative"><canvas id="salesChart"></canvas></div>
                        </div>
                        <div class="bg-white dark:bg-slate-900 p-4 md:p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
                            <h3 class="font-bold text-sm md:text-base text-slate-900 dark:text-white flex items-center gap-2">
                                <i data-lucide="clock" class="w-5 h-5 text-amber-500"></i> Deadline Terdekat
                            </h3>
                            <div id="dashDeadlineList" class="space-y-3 overflow-y-auto max-h-64"></div>
                        </div>
                    </div>
                </section>

                <!-- TAB 2: DAFTAR ORDER & SPK -->
                <section id="tab-spk" class="tab-content hidden space-y-6">
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white dark:bg-slate-900 p-4 md:p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
                        <div class="flex items-center gap-3 flex-wrap w-full sm:w-auto">
                            <div>
                                <h3 class="text-base md:text-lg font-bold text-slate-900 dark:text-white">Daftar Order & SPK</h3>
                                <p class="text-xs text-slate-500 mt-1">Kelola surat perintah kerja dan status pengerjaan.</p>
                            </div>
                            <select id="filterSpkStatus" onchange="renderSPK()" class="px-3 py-2 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs w-full sm:w-auto">
                                <option value="">Semua Status</option>
                                <option value="Antrian">Antrian</option>
                                <option value="Proses Potong">Proses Potong</option>
                                <option value="Proses Jahit">Proses Jahit</option>
                                <option value="Finishing & QC">Finishing & QC</option>
                                <option value="Selesai">Selesai</option>
                            </select>
                        </div>
                        <button onclick="openSPKModal()" class="w-full sm:w-auto px-4 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-medium text-sm flex items-center justify-center gap-2 shadow-lg shadow-rose-600/20">
                            <i data-lucide="plus" class="w-4 h-4"></i> Buat SPK Baru
                        </button>
                    </div>

                    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse min-w-[700px]">
                                <thead>
                                    <tr class="bg-slate-50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-800 text-xs font-semibold text-slate-500 uppercase">
                                        <th class="p-3 md:p-4">No. SPK / Tgl Masuk</th>
                                        <th class="p-3 md:p-4">Design</th>
                                        <th class="p-3 md:p-4">Klien & Kontak</th>
                                        <th class="p-3 md:p-4">Pakaian & Bahan & Qty</th>
                                        <th class="p-3 md:p-4">Total Tagihan</th>
                                        <th class="p-3 md:p-4">Kekurangan</th>
                                        <th class="p-3 md:p-4">Status</th>
                                        <th class="p-3 md:p-4 text-right">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody id="spkTableBody" class="divide-y divide-slate-100 dark:divide-slate-800 text-xs md:text-sm"></tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <!-- TAB 3: MASTER PAKAIAN & KAIN (Terpisah) -->
                <section id="tab-master_fabric" class="tab-content hidden space-y-6">
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <!-- Jenis Pakaian Master -->
                        <div class="bg-white dark:bg-slate-900 p-4 md:p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
                            <div class="flex justify-between items-center">
                                <div>
                                    <h3 class="text-sm md:text-base font-bold text-slate-900 dark:text-white">Master Jenis Pakaian</h3>
                                    <p class="text-xs text-slate-500">Kelola jenis pakaian, harga jual, dan tarif produksi</p>
                                </div>
                                <button onclick="openGarmentModal()" class="px-3 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-medium text-xs flex items-center gap-1.5 flex-shrink-0">
                                    <i data-lucide="plus" class="w-3.5 h-3.5"></i> Tambah
                                </button>
                            </div>
                            <div class="overflow-x-auto">
                                <table class="w-full text-left border-collapse min-w-[350px]">
                                    <thead>
                                        <tr class="bg-slate-50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-800 text-xs font-semibold text-slate-500 uppercase">
                                            <th class="p-3">Nama Pakaian</th>
                                            <th class="p-3">Harga Jual</th>
                                            <th class="p-3">Tarif (Jahit/Potong/QC)</th>
                                            <th class="p-3 text-right">Aksi</th>
                                        </tr>
                                    </thead>
                                    <tbody id="garmentTableBody" class="divide-y divide-slate-100 dark:divide-slate-800 text-xs"></tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Jenis Kain Master -->
                        <div class="bg-white dark:bg-slate-900 p-4 md:p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
                            <div class="flex justify-between items-center">
                                <div>
                                    <h3 class="text-sm md:text-base font-bold text-slate-900 dark:text-white">Master Jenis Bahan Kain</h3>
                                    <p class="text-xs text-slate-500">Kelola bahan kain & konsumsi size (meter per pcs)</p>
                                </div>
                                <button onclick="openFabricModal()" class="px-3 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-xs flex items-center gap-1.5 flex-shrink-0">
                                    <i data-lucide="plus" class="w-3.5 h-3.5"></i> Tambah
                                </button>
                            </div>
                            <div class="overflow-x-auto">
                                <table class="w-full text-left border-collapse min-w-[350px]">
                                    <thead>
                                        <tr class="bg-slate-50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-800 text-xs font-semibold text-slate-500 uppercase">
                                            <th class="p-3">Bahan Kain</th>
                                            <th class="p-3">Harga (Rp/kg)</th>
                                            <th class="p-3">Rasio (kg->m)</th>
                                            <th class="p-3 text-right">Aksi</th>
                                        </tr>
                                    </thead>
                                    <tbody id="fabricTableBody" class="divide-y divide-slate-100 dark:divide-slate-800 text-xs"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- TAB 4: MASTER CETAK & HARGA -->
                <section id="tab-master_print" class="tab-content hidden space-y-6">
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white dark:bg-slate-900 p-4 md:p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
                        <div>
                            <h3 class="text-base md:text-lg font-bold text-slate-900 dark:text-white">Master Metode Cetak & Harga</h3>
                            <p class="text-xs text-slate-500 mt-1">Tambah, ubah, atau hapus jenis metode cetak beserta tarif dan total pengeluaran biaya cetak per order.</p>
                        </div>
                        <button onclick="openMasterPrintModal()" class="w-full sm:w-auto px-4 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-medium text-sm flex items-center justify-center gap-2">
                            <i data-lucide="plus" class="w-4 h-4"></i> Tambah Metode Cetak Baru
                        </button>
                    </div>

                    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse min-w-[650px]">
                                <thead>
                                    <tr class="bg-slate-50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-800 text-xs font-semibold text-slate-500 uppercase">
                                        <th class="p-4">ID / Kode</th>
                                        <th class="p-4">Nama Metode Cetak</th>
                                        <th class="p-4">Satuan</th>
                                        <th class="p-4">Tarif Harga (Rp)</th>
                                        <th class="p-4">Total Pengeluaran Biaya Cetak</th>
                                        <th class="p-4 text-right">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody id="masterPrintTableBody" class="divide-y divide-slate-100 dark:divide-slate-800 text-sm"></tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <!-- TAB 5: INVENTORY STOCK -->
                <section id="tab-inventory" class="tab-content hidden space-y-6">
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white dark:bg-slate-900 p-4 md:p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
                        <div>
                            <h3 class="text-base md:text-lg font-bold text-slate-900 dark:text-white">Inventory Stock Kain & Bahan</h3>
                            <p class="text-xs text-slate-500 mt-1">Stok otomatis bertambah saat pembelian bahan di kas dan berkurang sesuai rasio pemakaian SPK.</p>
