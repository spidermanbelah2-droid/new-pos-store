        window.saveSPK = function(e) {
            e.preventDefault();
            let id = document.getElementById('spkId').value || 'spk-' + Date.now();
            let newSpk = {
                id,
                number: document.getElementById('spkNumber').value,
                dateIn: document.getElementById('spkDateIn').value,
                client: document.getElementById('spkClient').value,
                phone: document.getElementById('spkPhone').value,
                deadline: document.getElementById('spkDeadline').value,
                address: document.getElementById('spkAddress').value,
                garmentType: document.getElementById('spkGarmentType').value,
                fabricMaterial: document.getElementById('spkFabricMaterial').value,
                fabricColor: document.getElementById('spkFabricColor').value,
                printMethod: document.getElementById('spkPrintMethod').value,
                sizes: {
                    S: parseInt(document.getElementById('sizeS').value)||0,
                    M: parseInt(document.getElementById('sizeM').value)||0,
                    L: parseInt(document.getElementById('sizeL').value)||0,
                    XL: parseInt(document.getElementById('sizeXL').value)||0,
                    XXL: parseInt(document.getElementById('sizeXXL').value)||0,
                    XXXL: parseInt(document.getElementById('sizeXXXL').value)||0,
                    custom: parseInt(document.getElementById('sizeCustom').value)||0
                },
                pricePerPcs: parseFloat(document.getElementById('spkPricePerPcs').value),
                opex: parseFloat(document.getElementById('spkOpex').value),
                useCommission: document.getElementById('spkUseCommission').value,
                incentivePerPcs: parseFloat(document.getElementById('spkIncentivePerPcs').value),
                dp: parseFloat(document.getElementById('spkDp').value) || 0,
                dpAccount: document.getElementById('spkDpAccount').value,
                addToSalary: document.getElementById('spkAddToSalary').checked,
                designFile: document.getElementById('spkDesignFile').value,
                notes: document.getElementById('spkNotes').value,
                status: document.getElementById('spkStatus').value
            };

            let calc = calcSpkValues(newSpk);

            let existingIdx = appData.spk.findIndex(s => s.id === id);
            if (existingIdx >= 0) {
                let oldSpk = appData.spk[existingIdx];
                let oldCalc = calcSpkValues(oldSpk);
                let oldInv = appData.inventory.find(i => i.name === oldSpk.fabricMaterial);
                if (oldInv) oldInv.stock += oldCalc.fabricKg;
                appData.salaries = appData.salaries.filter(sal => sal.spkId !== id);
            }

            let invItem = appData.inventory.find(i => i.name === newSpk.fabricMaterial);
            if (invItem) {
                invItem.stock -= calc.fabricKg;
            } else {
                appData.inventory.push({ id: 'inv-' + Date.now(), name: newSpk.fabricMaterial, category: 'Kain Roll', stock: -calc.fabricKg, min: 5 });
            }

            if (newSpk.dp > 0 && existingIdx < 0) {
                if (newSpk.dpAccount === 'gopay') appData.balances.gopay += newSpk.dp;
                else appData.balances.mandiri += newSpk.dp;

                appData.finance.push({
                    id: 'fin-' + Date.now(),
                    date: newSpk.dateIn,
                    desc: `DP Order ${newSpk.number} (${newSpk.client})`,
                    account: newSpk.dpAccount,
                    type: 'Masuk',
                    category: 'Order Konveksi',
                    amount: newSpk.dp
                });
            }

            if (newSpk.addToSalary && calc.totalSalary > 0) {
                appData.salaries.push({
                    id: 'sal-' + Date.now(),
                    spkId: id,
                    name: `Gaji & Komisi SPK ${newSpk.number} (${newSpk.client})`,
                    role: 'Insentif & Komisi Klien',
                    amount: calc.totalSalary,
                    status: 'Belum Dibayar'
                });
            }

            if (existingIdx >= 0) appData.spk[existingIdx] = newSpk;
            else appData.spk.push(newSpk);

            syncToCloud();
            closeSPKModal();
        };

