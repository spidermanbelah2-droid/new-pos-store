    <!-- Firebase & App Script -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, setDoc, onSnapshot } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        const appId = (typeof __app_id !== 'undefined' && __app_id) ? __app_id : 'savelle_store_default';
        const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : { apiKey: "demo", projectId: "demo" };

        let db, auth, userId = null;
        let salesChartInstance = null;

        const defaultAppData = {
            balances: { mandiri: 0, gopay: 0 },
            masterGarments: [
                { id: 'gm-1', name: 'Kaos', basePrice: 75000, sewRate: 10000, cutRate: 2500, qcRate: 1500 },
                { id: 'gm-2', name: 'Kemeja', basePrice: 120000, sewRate: 18000, cutRate: 3000, qcRate: 2000 },
                { id: 'gm-3', name: 'Hoodie', basePrice: 150000, sewRate: 25000, cutRate: 3500, qcRate: 2500 }
            ],
            masterFabrics: [
                { id: 'fm-1', name: 'Cotton Combed 30s', pricePerKg: 85000, ratio: 3.5, cons: { S: 1.3, M: 1.4, L: 1.5, XL: 1.6, XXL: 1.7, XXXL: 1.8, custom: 2.0 } },
                { id: 'fm-2', name: 'Drill American', pricePerKg: 95000, ratio: 3.0, cons: { S: 1.8, M: 1.9, L: 2.0, XL: 2.2, XXL: 2.4, XXXL: 2.6, custom: 3.0 } },
                { id: 'fm-3', name: 'Fleece Cotton', pricePerKg: 110000, ratio: 2.5, cons: { S: 2.0, M: 2.1, L: 2.2, XL: 2.4, XXL: 2.6, XXXL: 2.8, custom: 3.2 } }
            ],
            masterPrint: [
                { id: 'mp-1', code: 'sablon', name: 'Sablon Manual/Plastisol', unit: 'pcs', price: 5000 },
                { id: 'mp-2', code: 'dtf', name: 'Sablon DTF Premium', unit: 'pcs', price: 7500 },
                { id: 'mp-3', code: 'sublim', name: 'Printing Sublimasi Full', unit: 'meter', price: 7000 },
                { id: 'mp-4', code: 'bordir', name: 'Bordir Komputer', unit: 'pcs', price: 8000 }
            ],
            spk: [],
            inventory: [],
            finance: [],
            salaries: []
        };

        let appData = JSON.parse(JSON.stringify(defaultAppData));

        window.renderDashboard = renderDashboard;
        window.renderSPK = renderSPK;
        window.renderMasterFabricAndGarment = renderMasterFabricAndGarment;
        window.renderMasterPrint = renderMasterPrint;
        window.renderInventory = renderInventory;
        window.renderFinance = renderFinance;
        window.renderRevenue = renderRevenue;
        window.renderSalaries = renderSalaries;
        window.renderAll = renderAll;

        try {
            const app = initializeApp(firebaseConfig);
            db = getFirestore(app);
            auth = getAuth(app);

            const initAuth = async () => {
                try {
                    if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                        await signInWithCustomToken(auth, __initial_auth_token);
                    } else {
                        await signInAnonymously(auth);
                    }
                    userId = auth.currentUser?.uid || crypto.randomUUID();
                    setupRealtimeSync();
                } catch (authErr) {
                    loadFromLocalStorage();
                }
            };
            initAuth();
        } catch (e) {
            loadFromLocalStorage();
        }

        function loadFromLocalStorage() {
            try {
                const saved = localStorage.getItem('savelle_app_data_' + appId);
                if (saved) appData = JSON.parse(saved);
            } catch (e) {}
            renderAll();
        }

        function setupRealtimeSync() {
            if (!db || !userId) { loadFromLocalStorage(); return; }
            try {
                const docRef = doc(db, 'artifacts', appId, 'public_data', 'store_main_v14');
                onSnapshot(docRef, (docSnap) => {
                    if (docSnap.exists()) {
                        const cloudData = docSnap.data();
                        if (cloudData && cloudData.payload) {
                            appData = JSON.parse(cloudData.payload);
                            renderAll();
                        }
                    } else {
                        syncToCloud();
                    }
                }, (error) => { loadFromLocalStorage(); });
            } catch(e) {
                loadFromLocalStorage();
            }
        }

        window.syncToCloud = function() {
            renderAll();
            try { localStorage.setItem('savelle_app_data_' + appId, JSON.stringify(appData)); } catch (e) {}
            if (!db || !userId) return;
            try {
