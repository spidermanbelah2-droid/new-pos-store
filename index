        window.executeTransfer = function(e) {
            e.preventDefault();
            let from = document.getElementById('trFrom').value;
            let to = document.getElementById('trTo').value;
            let amount = parseFloat(document.getElementById('trAmount').value);

            if (appData.balances[from] < amount) {
                showModal('Gagal', 'Saldo akun asal tidak mencukupi!', () => {});
                return;
            }

            appData.balances[from] -= amount;
            appData.balances[to] += amount;

            appData.finance.push({
                id: 'fin-' + Date.now(),
                date: new Date().toISOString().split('T')[0],
                desc: `Transfer saldo dari ${from.toUpperCase()} ke ${to.toUpperCase()}`,
                account: from,
                type: 'Keluar',
                category: 'Transfer',
                amount
            });

            syncToCloud();
            closeTransferModal();
        };

        window.saveFinance = function(e) {
            e.preventDefault();
            let category = document.getElementById('finCategory').value;
            let amount = parseFloat(document.getElementById('finAmount').value);
            let salId = document.getElementById('finSalaryId').value;

            let tx = {
                id: 'fin-' + Date.now(),
                date: document.getElementById('finDate').value,
                desc: document.getElementById('finDesc').value,
                account: 'gopay',
                type: document.getElementById('finType').value,
                category: category,
                amount: amount,
                salaryId: (category === 'Gaji Karyawan' ? salId : null)
            };

            if (tx.type === 'Masuk') {
                appData.balances.gopay += tx.amount;
            } else {
                if (appData.balances.gopay < tx.amount) {
                    showModal('Gagal', 'Saldo GoPay tidak cukup!', () => {});
                    return;
                }
                appData.balances.gopay -= tx.amount;
            }

            if (category === 'Beli Bahan Kain' || category === 'Packaging') {
                let inv = appData.inventory.find(i => i.name.toLowerCase().includes('kain') || i.category === category);
                if (inv) inv.stock += (tx.amount / 50000);
                else appData.inventory.push({ id: 'inv-' + Date.now(), name: tx.desc, category: category, stock: 10, min: 5 });
            }

            if (category === 'Gaji Karyawan' && salId) {
                let salObj = appData.salaries.find(s => s.id === salId);
                if (salObj) {
                    salObj.status = 'Lunas';
                }
            }

            appData.finance.push(tx);
            syncToCloud();
            closeFinanceModal();
        };

        window.deleteFinance = function(id) {
            let tx = appData.finance.find(f => f.id === id);
            if (tx && tx.category === 'Gaji Karyawan' && tx.salaryId) {
                let salObj = appData.salaries.find(s => s.id === tx.salaryId);
                if (salObj) salObj.status = 'Belum Dibayar';
            }
            appData.finance = appData.finance.filter(f => f.id !== id);
            syncToCloud();
        };

        function renderFinance() {
            let start = document.getElementById('filterStartDate').value;
            let end = document.getElementById('filterEndDate').value;

            let filtered = appData.finance.filter(f => {
                if (start && f.date < start) return false;
                if (end && f.date > end) return false;
                return true;
            });

            let totalIn = filtered.filter(f => f.type === 'Masuk').reduce((a,b) => a + b.amount, 0);
            let totalOut = filtered.filter(f => f.type === 'Keluar').reduce((a,b) => a + b.amount, 0);

            document.getElementById('finMandiriBal').innerText = formatRupiah(appData.balances.mandiri);
            document.getElementById('finGopayBal').innerText = formatRupiah(appData.balances.gopay);
            document.getElementById('finTotalIn').innerText = formatRupiah(totalIn);
            document.getElementById('finTotalOut').innerText = formatRupiah(totalOut);

            let tbody = document.getElementById('financeTableBody');
            tbody.innerHTML = filtered.map(f => `
                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
                    <td class="p-4 text-slate-400">${f.date}</td>
                    <td class="p-4 font-medium">${f.desc}</td>
                    <td class="p-4 uppercase font-bold text-xs text-emerald-500">${f.account}</td>
                    <td class="p-4">${f.category}</td>
                    <td class="p-4 font-bold ${f.type === 'Masuk' ? 'text-emerald-600' : 'text-rose-600'}">${f.type === 'Masuk' ? '+' : '-'}${formatRupiah(f.amount)}</td>
                    <td class="p-4 text-right">
                        <button onclick="deleteFinance('${f.id}')" class="text-rose-600"><i data-lucide="trash-2" class="w-4 h-4 inline"></i></button>
                    </td>
                </tr>
            `).join('');
            lucide.createIcons();
        }

        function renderRevenue() {
            let totTagihan = 0, totOpex = 0, totGaji = 0, totCogs = 0, totNet = 0;
            let tbody = document.getElementById('revenueTableBody');

            tbody.innerHTML = appData.spk.map(s => {
                let calc = calcSpkValues(s);
                totTagihan += calc.tagihan;
                totOpex += s.opex;
                totGaji += calc.totalSalary;
                totCogs += calc.totalCogsOverall;
                totNet += calc.netProfit;

                return `
                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
                        <td class="p-4 font-bold">${s.number}<div class="text-xs text-slate-400">${s.client}</div></td>
                        <td class="p-4">${formatRupiah(calc.tagihan)}</td>
                        <td class="p-4">${formatRupiah(calc.totalCogsOverall)}</td>
                        <td class="p-4">${formatRupiah(calc.totalSalary)}</td>
                        <td class="p-4">${formatRupiah(s.opex)}</td>
                        <td class="p-4 font-bold text-emerald-600">${formatRupiah(calc.netProfit)}</td>
                    </tr>
                `;
            }).join('');

            document.getElementById('revTotalTagihan').innerText = formatRupiah(totTagihan);
            document.getElementById('revTotalOpex').innerText = formatRupiah(totOpex);
            document.getElementById('revTotalGaji').innerText = formatRupiah(totGaji);
            document.getElementById('revTotalCogs').innerText = formatRupiah(totCogs);
            document.getElementById('revTotalNet').innerText = formatRupiah(totNet);
        }

